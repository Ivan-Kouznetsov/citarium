{
  "name": "citarium",
  "version": "0.1.0",
  "description": "Annotated Bibliography and Writing Project Manager (APA 7th Edition)",
  "type": "module",
  "scripts": {
    "start": "hutch run dev",
    "desktop": "hutch run dev",
    "desktop:stable": "bun run build && bun scripts/launch-stable.ts",
    "start:stable": "bun run desktop:stable",
    "dev": "hutch run dev",
    "test": "bun test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "bun test tests/*.test.ts && playwright test",
    "build": "hutch run build"
  },
  "dependencies": {
    "electrobun": "2.0.1",
    "zod": "3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.46.0",
    "@types/bun": "1.4.0",
    "typescript": "5.5.2"
  },
  "license": "AGPL-3.0"
}